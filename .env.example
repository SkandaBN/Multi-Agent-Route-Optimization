# Application Configuration
APP_NAME="Smart Logistics API"
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# CrewAI / LLM Configuration (Primary: Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=
GEMINI_MODEL_NAME=gemini-2.5-flash
GEMINI_TEMPERATURE=0.0
LLM_MODE=auto
CREWAI_TELEMETRY_OPT_OUT=true

# Optional fallback / legacy provider settings
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o-mini

# OR-Tools Solver Configuration
ORTOOLS_SOLVER_TIME_LIMIT_SECONDS=30

# Logistics Cost Modeling Assumptions
FUEL_EFFICIENCY_KM_PER_LITER=8.0
FUEL_PRICE_PER_LITER=1.5

